<%- include('partials/header') %>

    <main class="users-page">
        <h1>
            <%= title %>
        </h1>

        <div class="users-table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email (Username)</th>
                        <th>Role</th>
                    </tr>
                </thead>

                <tbody>
                    <% users.forEach(user=> { %>
                        <tr>
                            <td>
                                <%= user.name %>
                            </td>
                            <td>
                                <%= user.email %>
                            </td>
                            <td>
                                <%= user.role_name %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <%- include('partials/footer') %>
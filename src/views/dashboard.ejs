<%- include('partials/header') %>

    <main class="dashboard-page">
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-card">
            <h2>Dashboard</h2>

            <p>Name: <strong>
                    <%= name %>
                </strong></p>
            <p>Username: <strong>
                    <%= email %>
                </strong></p>

            <% if (user && user.role_name==='admin' ) { %>
                <p>
                    <a href="/users">View All Users</a>
                </p>
                <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
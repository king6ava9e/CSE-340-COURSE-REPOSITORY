<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>

        <p>Date: <%= projectDetails.date %>
        </p>

        <p>Location: <%= projectDetails.location %>
        </p>

        <p>
            Organization:
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>

        <h3>Categories</h3>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <!-- Link to the assign categories form -->
        <p>
            <a href="/assign-categories/<%= projectDetails.project_id %>">
                Edit Categories
            </a>
        </p>

        <!-- Link to the edit project form -->
        <p>
            <a href="/edit-project/<%= projectDetails.project_id %>">
                Edit Project
            </a>
        </p>
    </main>

    <%- include('partials/footer') %>
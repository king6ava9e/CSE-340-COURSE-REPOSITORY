<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>

        <p>Date: <%= projectDetails.date %>
        </p>

        <p>Location: <%= projectDetails.location %>
        </p>

        <p>
            Organization:
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>

        <h3>Categories</h3>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <!-- Volunteer signup options for logged-in users -->
        <% if (isLoggedIn) { %>
            <section class="volunteer-actions">
                <% if (isVolunteer) { %>
                    <form action="/project/<%= projectDetails.project_id %>/unvolunteer" method="POST">
                        <button class="volunteer-button volunteer-button--withdraw" type="submit">
                            Withdraw Volunteer Signup
                        </button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                            <button class="volunteer-button" type="submit">
                                Volunteer for This Project
                            </button>
                        </form>
                        <% } %>
            </section>
            <% } %>

                <!-- Admin-only project management options -->
                <% if (user && user.role_name==='admin' ) { %>
                    <p>
                        <a href="/assign-categories/<%= projectDetails.project_id %>">
                            Edit Categories
                        </a>
                    </p>

                    <p>
                        <a href="/edit-project/<%= projectDetails.project_id %>">
                            Edit Project
                        </a>
                    </p>
                    <% } %>
    </main>

    <%- include('partials/footer') %>